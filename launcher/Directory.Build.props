<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>1.0.1</Version>
    <Product>Top Spin 4</Product>
    <!-- Build output stays in the repo's ignored out/ folder. -->
    <BaseOutputPath>$(MSBuildThisFileDirectory)../out/launcher/bin/$(MSBuildProjectName)/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)../out/launcher/obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
</Project>
