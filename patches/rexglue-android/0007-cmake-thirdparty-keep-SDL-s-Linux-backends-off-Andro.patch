From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: hjcoggan <hjcoggan2@gmail.com>
Date: Tue, 3 Nov 2026 18:21:28 +1000
Subject: [PATCH 07/35] cmake(thirdparty): keep SDL's Linux backends off
 Android

SDL's X11/Wayland/ALSA/PulseAudio/PipeWire options were enabled for every
UNIX-and-not-APPLE target. None of those libraries exists in the NDK or on the
device; SDL's android video driver and its AAudio/OpenSL ES audio drivers are
selected at runtime instead. Also drop SDL_UNIX_CONSOLE_BUILD, which would
assume a terminal.
---
 thirdparty/CMakeLists.txt | 14 +++++++++++---
 1 file changed, 11 insertions(+), 3 deletions(-)

diff --git a/thirdparty/CMakeLists.txt b/thirdparty/CMakeLists.txt
index f102b56..d3358c7 100644
--- a/thirdparty/CMakeLists.txt
+++ b/thirdparty/CMakeLists.txt
@@ -248,7 +248,13 @@ set(SDL_INSTALL ON CACHE BOOL "" FORCE)
 set(SDL_SHARED OFF CACHE BOOL "" FORCE)
 set(SDL_STATIC ON CACHE BOOL "" FORCE)
 set(SDL_TEST OFF CACHE BOOL "" FORCE)
-set(SDL_UNIX_CONSOLE_BUILD ON CACHE BOOL "" FORCE)
+# Android is not a UNIX console: SDL's android driver owns stdout and the
+# activity lifecycle.
+if(ANDROID)
+    set(SDL_UNIX_CONSOLE_BUILD OFF CACHE BOOL "" FORCE)
+else()
+    set(SDL_UNIX_CONSOLE_BUILD ON CACHE BOOL "" FORCE)
+endif()
 
 # Video provides the windowing/event layer; presenters create their own
 # D3D12/Vulkan surfaces from native handles, so SDL_RENDER stays off.
@@ -289,8 +295,10 @@ set(SDL_DUMMYAUDIO OFF CACHE BOOL "" FORCE)
 set(SDL_DUMMYVIDEO OFF CACHE BOOL "" FORCE)
 
 # Linux video and audio backends. Both video drivers are always built so the
-# one in use stays a runtime choice.
-if(UNIX AND NOT APPLE)
+# one in use stays a runtime choice. Android has its own SDL video/audio
+# drivers (android, aaudio/openslES) and neither X11, Wayland, ALSA, PulseAudio
+# nor PipeWire exists there.
+if(UNIX AND NOT APPLE AND NOT ANDROID)
     set(SDL_X11               ON  CACHE BOOL "" FORCE)
     set(SDL_WAYLAND           ON  CACHE BOOL "" FORCE)
     set(SDL_ALSA              ON  CACHE BOOL "" FORCE)
