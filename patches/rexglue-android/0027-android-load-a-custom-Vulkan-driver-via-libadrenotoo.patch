+  /**
+   * buffer is never written by CPU
+   */
+  CPU_WRITE_NEVER = 0ull /* (0 << 4) */,
+  /**
+   * buffer is rarely written by CPU
+   */
+  CPU_WRITE_RARELY = 32ull /* (2 << 4) */,
+  /**
+   * buffer is often written by CPU
+   */
+  CPU_WRITE_OFTEN = 48ull /* (3 << 4) */,
