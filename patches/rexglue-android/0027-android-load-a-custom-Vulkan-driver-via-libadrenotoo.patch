+   *
+   * buffer is used as a renderscript allocation
+   */
+  RENDERSCRIPT = 1048576ull /* (1ULL << 20) */,
+  /**
+   * bit 21 must be zero
+   *
+   *
+   * buffer is used as a video decoder output
+   */
+  VIDEO_DECODER = 4194304ull /* (1ULL << 22) */,
+  /**
+   * buffer is used as a sensor direct report output
