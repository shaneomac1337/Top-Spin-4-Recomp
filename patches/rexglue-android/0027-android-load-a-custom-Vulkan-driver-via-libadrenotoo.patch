+/**
+ * Supported HDR formats. Must be kept in sync with equivalents in Display.java.
+ */
+enum class Hdr : int32_t {
+  /**
+   * Device supports Dolby Vision HDR
+   */
+  DOLBY_VISION = 1,
+  /**
+   * Device supports HDR10
+   */
+  HDR10 = 2,
+  /**
+   * Device supports hybrid log-gamma HDR
+   */
+  HLG = 3,
+};
