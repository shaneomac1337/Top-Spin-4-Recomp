+// Android custom Vulkan loading (libadrenotools).
+//
+// Adapted from nfsmw-android `sdk/include/rex/ui/vulkan/android_gpu_driver.h`,
+// which is based on the adrenotools integration in
+// victorgbd/NFSMW-Recompiled-Mobile (BSD-2-Clause).
+// libadrenotools itself: BSD-2-Clause, see thirdparty/libadrenotools/LICENSE.
+//
+// Unlike nfsmw this reads the driver configuration from the environment, which
+// the Java activity sets before the native libraries load:
+//   REX_NATIVE_LIB_DIR  - nativeLibraryDir (hooks: libmain_hook.so, ...)
+//   REX_GPU_DRIVER_TMP  - writable temp dir (app cacheDir)
+//   REX_GPU_DRIVER_DIR  - unpacked ADPKG contents (meta.json + driver .so)
+//   REX_GPU_DRIVER_NAME - driver soname from meta.json (`libraryName`)
+// With REX_GPU_DRIVER_DIR/NAME unset this is a plain dlopen("libvulkan.so").
+#pragma once
+
+// Returns a dlopen handle the caller owns (adopts into its loader wrapper).
+extern "C" __attribute__((visibility("default"))) void* rex_android_open_vulkan();
