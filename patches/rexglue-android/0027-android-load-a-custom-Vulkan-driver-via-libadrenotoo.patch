index 0000000..2e235b1
--- /dev/null
+++ b/src/ui/vulkan/android_gpu_driver.cpp
@@ -0,0 +1,67 @@
+// Android custom Vulkan loader (libadrenotools -> Mesa Turnip).
+//
+// Adapted from nfsmw-android `sdk/src/ui/vulkan/android_gpu_driver.cpp`, which is
+// based on the adrenotools integration in victorgbd/NFSMW-Recompiled-Mobile
+// (BSD-2-Clause). libadrenotools: BSD-2-Clause (thirdparty/libadrenotools/LICENSE),
+// lib/linkernsbypass: BSD-2-Clause (lib/linkernsbypass/LICENSE).
+//
+// No KGSL turbo: it changes the device-wide power policy.
+// Adapted for Top Spin 4: the driver is selected through environment variables
+// (REX_NATIVE_LIB_DIR, REX_GPU_DRIVER_TMP, REX_GPU_DRIVER_DIR,
+// REX_GPU_DRIVER_NAME) set by TopSpin4Activity, not through cvars.
+#include <rex/ui/vulkan/android_gpu_driver.h>
+
+#include <adrenotools/driver.h>
+#include <android/log.h>
+#include <dlfcn.h>
+
+#include <cstdlib>
+#include <string>
+
+namespace {
+
+constexpr const char* kTag = "TS4-driver";
+
+std::string EnvOrEmpty(const char* name) {
+  const char* value = std::getenv(name);
+  return value ? std::string(value) : std::string();
+}
+
+void* OpenSystemLoader() {
+  __android_log_print(ANDROID_LOG_INFO, kTag,
+                      "No custom Vulkan driver configured; using the system loader");
+  return dlopen("libvulkan.so", RTLD_NOW | RTLD_LOCAL);
+}
+
+}  // namespace
+
+extern "C" void* rex_android_open_vulkan() {
+  const std::string hooks = EnvOrEmpty("REX_NATIVE_LIB_DIR");
+  const std::string temp = EnvOrEmpty("REX_GPU_DRIVER_TMP");
+  std::string directory = EnvOrEmpty("REX_GPU_DRIVER_DIR");
+  const std::string library = EnvOrEmpty("REX_GPU_DRIVER_NAME");
+
+  if (directory.empty() || library.empty()) {
+    return OpenSystemLoader();
+  }
+  if (hooks.empty()) {
+    // Without nativeLibraryDir the hook libraries cannot be found; a custom
+    // driver would fail to load, so keep the app usable on the system driver.
+    __android_log_print(ANDROID_LOG_ERROR, kTag,
+                        "REX_NATIVE_LIB_DIR is unset; cannot load custom driver %s",
+                        library.c_str());
+    return OpenSystemLoader();
+  }
+
+  if (directory.back() != '/') directory += '/';
+
+  // The same loader is used by the driver and by the game's own Vulkan instance.
+  void* handle = adrenotools_open_libvulkan(RTLD_NOW, ADRENOTOOLS_DRIVER_CUSTOM,
+                                            temp.empty() ? nullptr : temp.c_str(),
+                                            hooks.c_str(), directory.c_str(), library.c_str(),
+                                            nullptr, nullptr);
+  __android_log_print(handle ? ANDROID_LOG_INFO : ANDROID_LOG_ERROR, kTag,
+                      "Custom Vulkan loader %s: %s%s", handle ? "opened" : "failed",
+                      directory.c_str(), library.c_str());
+  return handle;  // Fail explicitly; never claim a system fallback is the custom driver.
+}
