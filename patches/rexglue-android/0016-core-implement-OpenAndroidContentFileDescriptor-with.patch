From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: hjcoggan <hjcoggan2@gmail.com>
Date: Tue, 3 Nov 2026 18:34:06 +1000
Subject: [PATCH 16/35] core: implement OpenAndroidContentFileDescriptor with
 JNI

include/rex/filesystem.h declared OpenAndroidContentFileDescriptor (and
IsAndroidContentUri) for Android, and MappedMemory::OpenForAndroidContentUri
called it, but nothing defined it, so librexruntime failed to link. Implement
both over the SDL activity's ContentResolver: content:// URIs are turned into a
detached ParcelFileDescriptor fd, which the existing mmap path then uses. The
JNI environment and activity come from SDL3, which already owns JNI_OnLoad.
---
 src/core/CMakeLists.txt         |   8 +-
 src/core/filesystem_android.cpp | 130 ++++++++++++++++++++++++++++++++
 2 files changed, 135 insertions(+), 3 deletions(-)
 create mode 100644 src/core/filesystem_android.cpp

diff --git a/src/core/CMakeLists.txt b/src/core/CMakeLists.txt
index 7079316..d4938f7 100644
--- a/src/core/CMakeLists.txt
+++ b/src/core/CMakeLists.txt
@@ -76,7 +76,7 @@ elseif(UNIX)
     )
     if(ANDROID)
         # Bionic has no ucontext on 64-bit; the switch is aarch64 assembly.
-        target_sources(rexcore PRIVATE fiber_android.cpp main_android.cpp)
+        target_sources(rexcore PRIVATE fiber_android.cpp filesystem_android.cpp main_android.cpp)
     endif()
 endif()
 
@@ -107,8 +107,10 @@ if(APPLE)
 elseif(ANDROID)
     # bionic has pthread, rt and dl in libc, and the NDK ships no libpthread or
     # librt stub to link against. libandroid provides
-    # android_get_device_api_level.
-    target_link_libraries(rexcore PRIVATE dl android)
+    # android_get_device_api_level. SDL3 supplies the JNI environment, the
+    # activity and the app's internal storage path for the Android filesystem
+    # layer.
+    target_link_libraries(rexcore PRIVATE dl android SDL3::SDL3)
 elseif(UNIX)
     target_link_libraries(rexcore PRIVATE pthread rt dl)
 endif()
diff --git a/src/core/filesystem_android.cpp b/src/core/filesystem_android.cpp
new file mode 100644
index 0000000..7422629
--- /dev/null
+++ b/src/core/filesystem_android.cpp
@@ -0,0 +1,130 @@
+/**
+ ******************************************************************************
+ * Xenia : Xbox 360 Emulator Research Project                                 *
+ ******************************************************************************
