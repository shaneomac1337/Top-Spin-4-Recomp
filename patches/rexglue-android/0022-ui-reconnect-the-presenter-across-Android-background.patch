+        (void)window;
+        if (WindowSDL* w = GetWindow(id)) {
+          w->HandleAndroidLifecycle(foreground);
+        }
+      }
+      break;
+    }
+#endif
     case SDL_EVENT_DROP_FILE: {
       if (WindowSDL* window = GetWindow(event.drop.windowID)) {
         window->HandleDropEvent(event);
