From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ts4-port <ts4-port@localhost>
Date: Wed, 4 Nov 2026 00:06:21 +1000
Subject: [PATCH 28/35] gpu: reset the write pointer on ring init and stop
 faking completion

VdInitializeRingBuffer reset read_ptr_index_ but left write_ptr_index_ at the
previous device's value. On the Loader -> Swing handoff the worker therefore
saw read = 0 with the old write pointer and replayed a dead command buffer; a
vertex constant (~0.1996f) was decoded as a Type-0 header claiming ~15949
registers, ExecutePacketType0 failed, and ExecutePrimaryBuffer returned
write_index, telling the guest every command ran. Debug aborts on the assert;
NDEBUG strips it and the guest waits forever (the loading-screen hang).

- InitializeRingBuffer: drop the write pointer before the read pointer.
- ExecutePrimaryBuffer: return read_index on a bad packet, not write_index.
- Release fence before the RPTR writeback: arm64 has no TSO, so without it the
  guest can see RPTR advance before the CP's memory writes are visible.

Also adds bring-up diagnostics (ring dump on overflow, first write-pointer
updates, one-per-second CP heartbeat) -- gate these behind a cvar before this
leaves bring-up.

Verified on device: 0 overflows, read == write, wraparound exercised, the
Loader -> Swing transition survives, gameplay reached with working input.
---
 include/rex/graphics/command_processor.h |  3 ++
 src/graphics/command_processor.cpp       | 56 +++++++++++++++++++++++-
 2 files changed, 57 insertions(+), 2 deletions(-)

diff --git a/include/rex/graphics/command_processor.h b/include/rex/graphics/command_processor.h
index 7fb4524..bbb2e66 100644
--- a/include/rex/graphics/command_processor.h
+++ b/include/rex/graphics/command_processor.h
@@ -257,6 +257,9 @@ class CommandProcessor {
 
   std::unique_ptr<rex::thread::Event> write_ptr_index_event_;
   std::atomic<uint32_t> write_ptr_index_;
+  // Bring-up diagnostics: how many times the guest published a write pointer, so a stalled
+  // loading screen can be told apart from a guest that never submitted work.
+  std::atomic<uint64_t> wptr_update_count_{0};
 
   // Some titles submit writes beyond the emulated register file range in PM4
   // packets. Preserve these values so dependent packet logic can still observe
diff --git a/src/graphics/command_processor.cpp b/src/graphics/command_processor.cpp
index 1dbf8a2..b621383 100644
--- a/src/graphics/command_processor.cpp
+++ b/src/graphics/command_processor.cpp
@@ -10,6 +10,8 @@
  */
 
 #include <algorithm>
+#include <atomic>
+#include <chrono>
 #include <unordered_map>
 #include <cinttypes>
 #include <cmath>
@@ -252,6 +254,19 @@ void CommandProcessor::WorkerThreadMain() {
     uint32_t write_ptr_index = write_ptr_index_.load();
     if (write_ptr_index == 0xBAADF00D || read_ptr_index_ == write_ptr_index) {
       SCOPE_profile_cpu_i("gpu", "rex::graphics::CommandProcessor::Stall");
+      // Bring-up heartbeat: if the guest spins on a loading screen, this says whether it is even
+      // submitting work (wptr_updates) and where the read pointer sits.
+      static std::atomic<int64_t> last_heartbeat_ns{0};
+      const int64_t now_ns =
+          std::chrono::duration_cast<std::chrono::nanoseconds>(
+              std::chrono::steady_clock::now().time_since_epoch())
+              .count();
+      int64_t last_ns = last_heartbeat_ns.load(std::memory_order_relaxed);
+      if (now_ns - last_ns > 1000000000ll &&
+          last_heartbeat_ns.compare_exchange_strong(last_ns, now_ns, std::memory_order_relaxed)) {
+        REXGPU_INFO("CP idle: read={:08X} write={:08X} wptr_updates={}", read_ptr_index_,
+                    write_ptr_index, wptr_update_count_.load(std::memory_order_relaxed));
+      }
       // We've run out of commands to execute.
       // We spin here waiting for new ones, as the overhead of waiting on our
       // event is too high.
@@ -283,6 +298,9 @@ void CommandProcessor::WorkerThreadMain() {
     // TODO(benvanik): use reader->Read_update_freq_ and only issue after moving
     //     that many indices.
     if (read_ptr_writeback_ptr_) {
+      // arm64 has no TSO: without a release fence the guest can observe RPTR advance before the
+      // command processor's memory writes (MEM_WRITE / EVENT_WRITE / resolve output) are visible.
+      std::atomic_thread_fence(std::memory_order_release);
       memory::store_and_swap<uint32_t>(memory_->TranslatePhysical(read_ptr_writeback_ptr_),
                                        read_ptr_index_);
     }
@@ -351,9 +369,16 @@ bool CommandProcessor::SetupContext() {
 void CommandProcessor::ShutdownContext() {}
 
 void CommandProcessor::InitializeRingBuffer(uint32_t ptr, uint32_t size_log2) {
-  read_ptr_index_ = 0;
+  // A new ring belongs to a new device: the previous device's write pointer must be dropped
+  // before the read pointer, or the worker sees read = 0 with the old write index and executes
+  // the old buffer (Top Spin 4 crashes on a Type-0 header inside stale data at the Loader -> Swing
+  // device handoff). Windows never hit this because it did not reset the CP between devices.
+  write_ptr_index_ = 0;
   primary_buffer_ptr_ = ptr;
   primary_buffer_size_ = uint32_t(1) << (size_log2 + 3);
+  read_ptr_index_ = 0;
+  REXGPU_INFO("InitializeRingBuffer(ptr={:08X}, size_log2={}, size={:08X}, words={})", ptr,
+              size_log2, primary_buffer_size_, primary_buffer_size_ / 4);
 }
 
 void CommandProcessor::EnableReadPointerWriteBack(uint32_t ptr, uint32_t block_size_log2) {
@@ -367,6 +392,10 @@ void CommandProcessor::EnableReadPointerWriteBack(uint32_t ptr, uint32_t block_s
 }
 
 void CommandProcessor::UpdateWritePointer(uint32_t value) {
+  wptr_update_count_.fetch_add(1, std::memory_order_relaxed);
+  if (wptr_update_count_.load(std::memory_order_relaxed) <= 8) {
+    REXGPU_INFO("UpdateWritePointer({:08X}) read={:08X}", value, read_ptr_index_);
+  }
   write_ptr_index_ = value;
   write_ptr_index_event_->Set();
 }
@@ -662,8 +691,13 @@ uint32_t CommandProcessor::ExecutePrimaryBuffer(uint32_t read_index, uint32_t wr
     if (!ExecutePacket(&reader)) {
       // This probably should be fatal - but we're going to continue anyways.
       REXGPU_ERROR("**** PRIMARY RINGBUFFER: Failed to execute packet.");
+      REXGPU_ERROR("  primary buffer={:08X} size={:08X} read_index={:08X} write_index={:08X}",
+                   primary_buffer_ptr_, primary_buffer_size_, read_index, write_index);
       assert_always();
-      break;
+      // Stop at the bad packet: returning write_index here would advance RPTR past commands that
+      // never ran and make the guest wait forever for work we claimed to complete. Hardware also
+      // stalls on an invalid packet, so this is the honest failure.
+      return read_index;
     }
   } while (reader.read_count());
 
@@ -743,6 +777,24 @@ bool CommandProcessor::ExecutePacketType0(memory::RingBuffer* reader, uint32_t p
   if (reader->read_count() < count * sizeof(uint32_t)) {
     REXGPU_ERROR("ExecutePacketType0 overflow (read count {:08X}, packet count {:08X})",
                  reader->read_count(), count * sizeof(uint32_t));
+    // Bring-up diagnostic: the header can claim more registers than the register file has, so
+    // dump the ring state and the words the reader actually saw. Stale bytes and a desynced
+    // read pointer look identical otherwise.
+    const uint8_t* base = reader->buffer();
+    const rex::memory::ring_size_t capacity = reader->capacity();
+    const rex::memory::ring_size_t offset = reader->read_offset();
+    uint32_t words[8] = {};
+    for (int i = 0; i < 8 && capacity >= sizeof(uint32_t); ++i) {
+      const rex::memory::ring_size_t at =
+          (offset + static_cast<rex::memory::ring_size_t>(i) * 4) % capacity;
+      words[i] = *reinterpret_cast<const uint32_t*>(base + at);
+    }
+    REXGPU_ERROR("  ring base={:016X} capacity={:08X} read_off={:08X} write_off={:08X}",
+                 static_cast<uint64_t>(reinterpret_cast<uintptr_t>(base)), capacity, offset,
+                 reader->write_offset());
+    REXGPU_ERROR("  packet={:08X} words: {:08X} {:08X} {:08X} {:08X} {:08X} {:08X} {:08X} {:08X}",
+                 packet, words[0], words[1], words[2], words[3], words[4], words[5], words[6],
+                 words[7]);
     return false;
   }
 
