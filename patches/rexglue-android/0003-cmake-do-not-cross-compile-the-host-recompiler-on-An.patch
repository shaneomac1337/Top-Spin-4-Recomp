From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: hjcoggan <hjcoggan2@gmail.com>
Date: Tue, 3 Nov 2026 18:19:21 +1000
Subject: [PATCH 03/35] cmake: do not cross-compile the host recompiler on
 Android

src/rexglue is the codegen CLI that produces the guest C++; it belongs on the
build machine. Building it for the target pulls the CLI/UI code into the
Android build for no benefit.
---
 CMakeLists.txt | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index f19c37f..a51babd 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -276,7 +276,11 @@ add_subdirectory(src/graphics)
 add_subdirectory(src/system)
 add_subdirectory(src/kernel)
 add_subdirectory(src/codegen)
-add_subdirectory(src/rexglue)
+# src/rexglue is the host recompiler CLI; it runs on the build machine, not on
+# the target, so it is not cross-compiled for Android.
+if(NOT ANDROID)
+    add_subdirectory(src/rexglue)
+endif()
 
 # Add tests subdirectory if tests are enabled
 if(REXGLUE_BUILD_TESTS)
