+/**
+ * @file        ui/vulkan/device_order.h
+ * @brief       Which Vulkan physical device automatic selection tries first
+ *
+ * Features decide first, as they always have. Between equally capable devices a discrete GPU comes
+ * first: on a hybrid laptop the integrated GPU is usually enumerated first and has the same
+ * features, so the game ran on it. A device that fails to initialize still falls through to the
+ * next one.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <vector>
+
+#include <rex/ui/vulkan/api.h>
+
+namespace rex::ui::vulkan {
+
+constexpr uint32_t DeviceTypeRank(VkPhysicalDeviceType type) {
+  switch (type) {
+    case VK_PHYSICAL_DEVICE_TYPE_DISCRETE_GPU:
+      return 0;
+    case VK_PHYSICAL_DEVICE_TYPE_INTEGRATED_GPU:
+      return 1;
+    case VK_PHYSICAL_DEVICE_TYPE_VIRTUAL_GPU:
+      return 2;
+    case VK_PHYSICAL_DEVICE_TYPE_CPU:
+      return 4;
+    default:
+      return 3;
+  }
+}
+
+template <typename Device>
+struct DeviceCandidate {
+  Device device;
+  uint32_t feature_score;
+  VkPhysicalDeviceType type;
+};
+
+// Most preferred features first, then by device type. Complete ties keep enumeration order.
+template <typename Device>
+void OrderDeviceCandidates(std::vector<DeviceCandidate<Device>>& candidates) {
+  std::stable_sort(candidates.begin(), candidates.end(),
+                   [](const DeviceCandidate<Device>& a, const DeviceCandidate<Device>& b) {
+                     if (a.feature_score != b.feature_score) {
+                       return a.feature_score > b.feature_score;
+                     }
+                     return DeviceTypeRank(a.type) < DeviceTypeRank(b.type);
+                   });
+}
+
+}  // namespace rex::ui::vulkan
