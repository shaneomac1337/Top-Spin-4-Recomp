 void CommandProcessor::InitializeRingBuffer(uint32_t ptr, uint32_t size_log2) {
+  // A Module loading its own D3D device moves the ring while the worker runs. The worker makes the
+  // change itself, between packets (ApplyRingReset). The old ring's write index means nothing on
+  // the new ring: left in place, the worker would run the new ring's unwritten memory up to it.
+  const uint32_t size = uint32_t(1) << (size_log2 + 3);
+  std::lock_guard<std::mutex> lock(ring_mutex_);
+  const uint32_t old_write = write_ptr_index_.exchange(0xBAADF00D);
+  pending_ring_ptr_ = ptr;
+  pending_ring_size_ = size;
+  // The old write-back memory belongs to the old device; EnableReadPointerWriteBack follows.
+  read_ptr_writeback_ptr_ = 0;
+  ring_reset_pending_ = true;
+  write_ptr_index_event_->Set();
+  REXGPU_INFO("Ring init: {:08X} size {:X} (old write index {:X})", ptr, size, old_write);
+}
